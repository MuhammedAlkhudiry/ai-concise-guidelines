{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [],
  "plugin": [],
  "keybinds": {
    "model_cycle_favorite": "ctrl+a",
    "model_cycle_favorite_reverse": "ctrl+shift+a"
  },
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "permission": {
    "external_directory": {
      "*": "ask",
      "<home>/PhpstormProjects/*": "allow",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "~/.config/*": "allow",
      "~/.agents/*": "allow"
    },
    "read": {
      "**/.env*": "allow"
    },
    "bash": {
      "ddev *": "allow",
      "git *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow"
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "general": {
      "model": "opencode-go/deepseek-v4-pro"
    }
  },
  "mcp": {
    "jetbrains": {
      "type": "remote",
      "url": "http://127.0.0.1:64342/stream"
    }
  }
}
