{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [],
  "plugin": [],
  "mcp": {
    "maestro": {
      "type": "local",
      "command": [
        "maestro",
        "mcp"
      ],
      "enabled": true,
      "timeout": 180000
    }
  },
  "tools": {
    "maestro_cheat_sheet": false,
    "maestro_list_cloud_devices": false,
    "maestro_run_on_cloud": false,
    "maestro_get_cloud_run_status": false,
    "maestro_describe_cloud_run": false
  },
  "keybinds": {
    "model_cycle_favorite": "ctrl+a",
    "model_cycle_favorite_reverse": "ctrl+shift+a"
  },
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4-flash",
  "permission": {
    "external_directory": {
      "*": "ask",
      "<home>/PhpstormProjects/*": "allow",
      "/tmp/*": "allow",
      "/private/tmp/*": "allow",
      "~/.config/*": "allow",
      "~/.agents/*": "allow"
    },
    "read": {
      "**/.env*": "allow"
    },
    "bash": {
      "herd *": "allow",
      "git *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "find *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow"
    }
  },
  "agent": {
    "plan": {
      "disable": true
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash"
    },
    "general": {
      "model": "opencode-go/deepseek-v4-pro"
    }
  }
}
